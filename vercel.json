{
    "buildCommand": "pip install -r requirements-vercel.txt && python main.py",
    "devCommand": "streamlit run streamlit_app.py",
    "installCommand": "pip install --upgrade pip && pip install -r requirements-vercel.txt",
    "python": {
        "version": "3.12"
    },
    "env": {
        "OPENAI_API_KEY": "@OPENAI_API_KEY",
        "ADMIN_PASSWORD": "@ADMIN_PASSWORD",
        "JWT_SECRET_KEY": "@JWT_SECRET_KEY"
    },
    "functions": {
        "main.py": {
            "runtime": "python3.12"
        }
    }
}